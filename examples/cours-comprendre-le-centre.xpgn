            },
            "caption": "La position de départ."
          },
          {
            "id": "exercice-e4",
            "type": "exercise",
            "prompt": "Quel coup de pion blanc occupe immédiatement une case centrale et attaque d5 ?",
            "position": {
              "fen": "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1"
            },
            "expectedMoves": ["e2e4"],
            "explanation": "1. e4 occupe le centre et contrôle notamment d5 et f5."
          }
